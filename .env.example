META_MODEL_API_KEY=
SCREEN_TIME_PASSWORD=
BLOB_READ_WRITE_TOKEN=
SCREEN_TIME_MAX_USD_PER_VIDEO=0.5
SCREEN_TIME_MAX_USD_TOTAL=20
SCREEN_TIME_LINK_SECRET=

# Optional: open-weight Muse Spark Open for the object check (any OpenAI-compatible host)
OPEN_BASE_URL=
OPEN_MODEL=
OPEN_API_KEY=
OPEN_PROVIDER=
OPEN_PROVIDER_ONLY=

# Optional: the Blob store's public host (<id>.public.blob.vercel-storage.com), needed when BLOB_READ_WRITE_TOKEN
# does not contain the store id
# BLOB_STORE_HOST=

# Optional: sample runs (TRY) and follow-up agent runs (AGENT) without the demo password, per visitor and for everyone
# per day (defaults shown)
# SCREEN_TIME_TRY_PER_VISITOR=3
# SCREEN_TIME_TRY_PER_DAY=25
# SCREEN_TIME_AGENT_PER_VISITOR=3
# SCREEN_TIME_AGENT_PER_DAY=20
# Budget kept for demo-password holders: runs without the password stop this many dollars short of the total cap
# SCREEN_TIME_OWNER_RESERVE_USD=5

# Optional: an ffmpeg binary to use instead of the one from ffmpeg-static
# FFMPEG_PATH=

# Local demo recording only, never on Vercel: 1 opens the local file and labelling routes on a production build
# SCREEN_TIME_LOCAL_FILES=
